<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/rich_black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/medium_tan"
        android:id="@+id/tvHint"
        android:background="@color/dark_charcoal"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/draw_selection_hint"
        android:textAlignment="center"/>
    <com.mobileinvoice.ocr.SelectionOverlayView
        android:id="@+id/selectionOverlay"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/champagne"
        android:ellipsize="end"
        android:id="@+id/tvResultPreview"
        android:background="@color/dark_charcoal"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"/>
    <HorizontalScrollView
        android:background="@color/charcoal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFields"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:chipSpacingHorizontal="8dp"
            app:singleSelection="true"/>
    </HorizontalScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/rich_black"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/gold"
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Reset"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:strokeColor="@color/rich_gold"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/rich_black"
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Done"
            android:layout_weight="1"
            app:backgroundTint="@color/rich_gold"/>
    </LinearLayout>
</LinearLayout>
