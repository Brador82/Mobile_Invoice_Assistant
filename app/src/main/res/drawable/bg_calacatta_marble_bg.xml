<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark charcoal base for contrast -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2a2025"
                android:endColor="#1e1820"
                android:angle="270"
                android:type="linear"
                android:centerColor="#241c22"/>
        </shape>
    </item>
    <!-- Subtle warm undertone -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#08b71c1c"
                android:endColor="#04b71c1c"
                android:angle="315"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
