<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: black-to-white gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0a0a0a"
                android:centerColor="#3a3a3a"
                android:endColor="#c8c8c8"
                android:angle="90"
                android:type="linear"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <!-- Silver border/trim -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#c0c0c0"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <!-- Top gloss highlight for silver shine -->
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#55ffffff"
                android:centerColor="#10ffffff"
                android:endColor="#00000000"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <!-- Inner silver edge shimmer -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#18c0c0c0"
                android:endColor="#00000000"
                android:angle="45"
                android:type="linear"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</layer-list>
